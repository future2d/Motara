<UserControl
    x:Class="Motara.App.Controls.ModelLibraryMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Motara.App.Controls"
    x:CompileBindings="False"
    IsVisible="False">
  <Border
      Background="{DynamicResource SurfaceFloating}"
      BorderBrush="{DynamicResource BorderSubtle}"
      BorderThickness="1"
      BoxShadow="{DynamicResource FloatingSurfaceShadow}"
      CornerRadius="12"
      Padding="18"
      ClipToBounds="True">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />
      <Grid Grid.Row="1" ColumnDefinitions="1.25*,1,0.9*" ColumnSpacing="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            <ToggleSwitch x:Name="LayoutToggle" Grid.Column="1"
                          Theme="{DynamicResource MenuRowToggleTheme}"
                          Width="124"
                          HorizontalContentAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Panel x:Name="ModelsPanel" />
          </ScrollViewer>
          <StackPanel x:Name="ModelListActions" Grid.Row="2" Margin="0,10,0,0"
                      Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ImportButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
            <Button x:Name="RefreshButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
            <Button x:Name="OpenFolderButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
          </StackPanel>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerSubtle}" />
        <Grid Grid.Column="2">
          <StackPanel Spacing="12">
            <TextBlock x:Name="DetailsHeading" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock x:Name="SelectedName" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyDetailsText" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            <Grid x:Name="DetailsFields" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*"
                  RowSpacing="8">
              <TextBlock x:Name="CompatibilityLabel" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="CompatibilityValue" Grid.Column="1" FontSize="13"
                         Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
              <TextBlock x:Name="FormatLabel" Grid.Row="1" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="FormatValue" Grid.Row="1" Grid.Column="1" FontSize="13"
                         Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
              <TextBlock x:Name="VersionLabel" Grid.Row="2" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="VersionValue" Grid.Row="2" Grid.Column="1" FontSize="13"
                         Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
              <TextBlock x:Name="RoleLabel" Grid.Row="3" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
              <TextBlock x:Name="RoleValue" Grid.Row="3" Grid.Column="1" FontSize="13"
                         Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
            </Grid>
            <Border x:Name="ConfigurationReview" IsVisible="False" Padding="12"
                    Background="{DynamicResource SurfaceFloatingHover}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock x:Name="ConfigurationReviewMessage" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                   <Button x:Name="ConfigurationCancelButton"
                           Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="13" />
                   <Button x:Name="ConfigurationRepairButton"
                           Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="13"
                           IsVisible="False" />
                   <Button x:Name="ConfigurationConfirmButton"
                          Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="MappingReview" IsVisible="False" Padding="12"
                    Background="{DynamicResource SurfaceFloatingHover}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock x:Name="MappingReviewMessage" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button x:Name="MappingDeclineButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="13" />
                  <Button x:Name="MappingAcceptButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="DetailActions" Spacing="4">
              <Button x:Name="AssignButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                      MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
               <Button x:Name="BasicSettingsButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                       MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       IsEnabled="False" />
               <Button x:Name="EditButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                       MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       IsEnabled="False" />
               <Button x:Name="PhysicsButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                       MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       IsEnabled="False" />
               <Button x:Name="AdvancedSettingsButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                       MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       IsEnabled="False" />
               <Button x:Name="OrganizeButton" Theme="{DynamicResource MenuRowButtonTheme}" FontSize="14"
                      MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
