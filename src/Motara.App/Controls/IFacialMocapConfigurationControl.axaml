<UserControl
    x:Class="Motara.App.Controls.IFacialMocapConfigurationControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True">
  <StackPanel Width="560" Spacing="12">
    <TextBlock x:Name="LocalAddressLabel" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
    <ComboBox x:Name="LocalAddress" FontSize="14" />
    <TextBlock x:Name="DeviceAddressLabel" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
    <TextBox x:Name="DeviceAddress" FontSize="14" />
    <TextBlock x:Name="PortLabel" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
    <TextBox x:Name="Port" Width="160" HorizontalAlignment="Left" FontSize="14" />
    <TextBlock x:Name="Error" MinHeight="20" FontSize="14"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
    <StackPanel Classes="workspace-footer" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
      <Button x:Name="Cancel" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
      <Button x:Name="Connect" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
    </StackPanel>
  </StackPanel>
</UserControl>
