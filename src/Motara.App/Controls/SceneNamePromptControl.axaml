<UserControl
    x:Class="Motara.App.Controls.SceneNamePromptControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="True">
  <StackPanel Width="560" Spacing="16">
    <TextBlock x:Name="Label" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
    <TextBox x:Name="Input" FontSize="14" />
    <StackPanel Classes="workspace-footer" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
      <Button x:Name="Cancel" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
      <Button x:Name="Submit" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
    </StackPanel>
  </StackPanel>
</UserControl>
