<UserControl x:Class="Motara.App.Controls.FriendInviteAcceptanceControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Width="560">
    <StackPanel Spacing="14">
      <TextBlock x:Name="InviteLabel" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
      <TextBox x:Name="InviteInput" FontSize="13" AcceptsReturn="False" />
      <TextBlock x:Name="NameLabel" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
      <TextBox x:Name="NameInput" FontSize="14" MaxLength="80" />
      <TextBlock x:Name="ValidationText" MinHeight="20" FontSize="12"
                 Foreground="{DynamicResource StatusError}" TextWrapping="Wrap" />
      <StackPanel Classes="workspace-footer" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="CancelButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
        <Button x:Name="ConfirmButton" Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
      </StackPanel>
    </StackPanel>
    <Border x:Name="ResultPanel" IsVisible="False" Padding="18" CornerRadius="10"
            Background="{DynamicResource SurfaceFloating}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
            BoxShadow="{DynamicResource FloatingSurfaceShadow}">
      <StackPanel Spacing="16">
        <TextBlock x:Name="ResultText" FontSize="14" Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap" />
        <Button x:Name="AcknowledgeButton" Classes="workspace-footer" HorizontalAlignment="Right"
                Theme="{DynamicResource WorkspaceActionButtonTheme}" FontSize="14" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
